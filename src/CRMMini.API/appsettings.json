{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "CRMMini",
    "Audience": "CRMMini.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "SecuritySettings": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "AuthPermitLimit": 30,
    "ApiPermitLimit": 300
  },
  "SeedData": {
    "Enabled": false,
    "DefaultDemoPassword": ""
  },
  "Database": {
    "InitializeOnStartup": true,
    "AutoMigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
